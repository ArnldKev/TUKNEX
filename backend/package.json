{
  "name": "tuknex-backend",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node scripts/start-production.mjs",
    "test": "npm run build && node --test scripts/test-quote-project.mjs && node scripts/test-billing-integration.mjs && node scripts/test-auth-integration.mjs && node scripts/test-setup-http.mjs && node scripts/test-production-integration.mjs && node scripts/test-reviews-integration.mjs && node --test scripts/test-private-admin-cli.mjs",
    "db:migrate": "tsx --tsconfig tsconfig.json src/migrate.ts",
    "setup": "npm run build && node scripts/setup-postgres.mjs",
    "test:postgres": "npm run build && node scripts/test-auth-integration.mjs --postgres && node scripts/test-production-integration.mjs --postgres && node scripts/test-reviews-integration.mjs --postgres",
    "test:setup": "node scripts/test-setup-http.mjs",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:migrate:prod": "node dist/migrate.js",
    "admin:create": "npm run build && node scripts/create-admin.mjs",
    "test:quote-project": "npm run build && node --test scripts/test-quote-project.mjs",
    "test:admin": "node --test scripts/test-private-admin-cli.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

NODE_ENV=development
PORT=4000
SERVER_HOST=127.0.0.1
BILLING_MODE=production
DATA_DIR=.local-data/billing
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:4173
SESSION_SAMESITE=lax
ISSUER_NAME=
ISSUER_TAX_ID=
ISSUER_ADDRESS=
ISSUER_EMAIL=
ISSUER_PHONE=

# La verificación de contacto se conserva, pero está desactivada por defecto.
REQUIRE_EMAIL_VERIFICATION=false
CONTACT_VERIFICATION_ENABLED=false
REQUIRE_PHONE_VERIFICATION=false
VERIFICATION_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TRUST_PROXY_HOPS=0
PG_DUMP_PATH=

# Borradores compartidos: activar solo después de elegir la conservación y publicar el aviso.
QUOTE_DRAFTS_ENABLED=false
QUOTE_DRAFTS_RETENTION_DAYS=30

# IA opcional: solo backend, Groq gratuito; no se habilita facturación automáticamente.
NEXI_AI_ENABLED=false
NEXI_AI_PROVIDER=groq
NEXI_AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
